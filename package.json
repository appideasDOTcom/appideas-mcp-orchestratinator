    "set-version": "node scripts/set-version.mjs",
    "release-gate": "bash scripts/release-gate.sh",
    "coverage": "bash scripts/coverage/run.sh",
    "test:admin": "node test/admin.mjs",
    "test:auth": "node test/auth.mjs",
    "test:boardlog": "node test/board-log.mjs",
    "test:capture": "node test/capture.mjs",
    "test:update": "node test/update.mjs",
    "test": "npm run smoke && npm run test:admin && npm run test:auth && npm run test:boardlog && npm run test:capture && npm run test:floor && npm run test:markdown && npm run test:plugin && npm run test:update && npm run test:host && npm run test:seats && npm run test:agent && npm run test:claude",
    "test:floor": "node test/floor.mjs",
    "test:markdown": "node test/markdown.mjs",
    "test:host": "node test/host.mjs",
    "host": "node host/index.js",
    "test:seats": "node test/seats.mjs",
    "test:plugin": "node test/plugin.mjs",
    "test:agent": "node test/agent.mjs",
    "test:claude": "node test/claude.mjs"
  },
  "dependencies": {
