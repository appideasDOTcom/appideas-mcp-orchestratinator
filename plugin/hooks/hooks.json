{
  "description": "Report this session's state to the orchestratinator floor. Every event reads stdin and detaches, so nothing is on the critical path of a turn. The floor reads the conversation itself from Claude Code's own transcript; these hooks say what is happening, not what was said.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=$(cat); [ -n \"$p\" ] && (printf '%s' \"$p\" | node \"${CLAUDE_PLUGIN_ROOT}/hooks/report.mjs\" >/dev/null 2>&1 &); exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=$(cat); [ -n \"$p\" ] && (printf '%s' \"$p\" | node \"${CLAUDE_PLUGIN_ROOT}/hooks/report.mjs\" >/dev/null 2>&1 &); exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=$(cat); [ -n \"$p\" ] && (printf '%s' \"$p\" | node \"${CLAUDE_PLUGIN_ROOT}/hooks/report.mjs\" >/dev/null 2>&1 &); exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=$(cat); [ -n \"$p\" ] && (printf '%s' \"$p\" | node \"${CLAUDE_PLUGIN_ROOT}/hooks/report.mjs\" >/dev/null 2>&1 &); exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=$(cat); [ -n \"$p\" ] && (printf '%s' \"$p\" | node \"${CLAUDE_PLUGIN_ROOT}/hooks/report.mjs\" >/dev/null 2>&1 &); exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=$(cat); [ -n \"$p\" ] && (printf '%s' \"$p\" | node \"${CLAUDE_PLUGIN_ROOT}/hooks/report.mjs\" >/dev/null 2>&1 &); exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=$(cat); [ -n \"$p\" ] && (printf '%s' \"$p\" | node \"${CLAUDE_PLUGIN_ROOT}/hooks/report.mjs\" >/dev/null 2>&1 &); exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=$(cat); [ -n \"$p\" ] && (printf '%s' \"$p\" | node \"${CLAUDE_PLUGIN_ROOT}/hooks/report.mjs\" >/dev/null 2>&1 &); exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
