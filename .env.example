# Copy to .env (gitignored). `docker compose` reads .env for ${VAR} substitution
# and the server loads it itself, so `npm start` sees the same values.

# Shared secret every MCP client must present, as either
#   X-Orchestratinator-Key: <token>
# or
#   Authorization: Bearer <token>
# One key for all agents — it keeps a casual port-scan off the board, it does
# not make X-Agent trustworthy. Leave it empty to disable auth entirely.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ORCH_AUTH_TOKEN=

# off | warn | enforce. Defaults to enforce whenever a token is set; `off` is
# implied when it isn't. Use `warn` to roll auth out without interrupting agents
# that are mid-task: bad and missing keys are logged but allowed, so you can
# watch the log until every client has been updated, then switch to enforce.
ORCH_AUTH_MODE=enforce

# Also require the key for the dashboard at `/` and its /api/* endpoints. Off by
# default — a browser can't set a custom header, so with this on you open
# http://localhost:PORT/?key=<token> once and the server drops a cookie.
ORCH_AUTH_PROTECT_UI=false

# --- humans at the dashboard ------------------------------------------------
# The shared secret above is the wrong shape for a person: one static string
# everybody holds, which you can't revoke for one holder and which says nothing
# about who took an action. Dashboard accounts (Settings ⚙ → Users) fix that.
#
# A sign-in is required as soon as one enabled account exists, so creating the
# first account is what closes the door — and deleting them all opens it again.
#
# The first account can come from here, which is also the way back in if everyone
# forgets their password: delete every account, set these, restart. Only ever
# applied when the user table is completely empty, so it can never undo a password
# change you made in the UI. Leave both blank to create the first account by hand
# instead (open /?key=<token> once, then use the gear).
ORCH_ADMIN_USER=
ORCH_ADMIN_PASSWORD=

# How long a browser stays signed in, in days. Sliding: it renews while in use.
ORCH_SESSION_DAYS=30

# Force the `Secure` flag on the session cookie. Unset means "secure whenever the
# request arrived over TLS", which is right on a laptop (plain http) and behind a
# TLS proxy (https) without needing changing. Set it to true once this is only ever
# reachable over https, so a stray http request can't be handed a cookie.
# ORCH_COOKIE_SECURE=

# Which proxies to believe about the client's IP and protocol. Express syntax:
# `loopback` (the default), a subnet, a hop count, or `true` for "trust whatever
# X-Forwarded-For says".
#
# Worth knowing: under Docker with nothing in front of it, every request already
# arrives from the bridge gateway, so the login throttle sees one source address
# for the world and degrades to per-username. A determined guesser could then keep
# one account in its 10-minute cooldown. Two things make that survivable rather
# than serious: the port is published on 127.0.0.1 only, and /?key=<token> is
# always a way in. Put a reverse proxy in front and set this, and real client
# addresses come back.
# TRUST_PROXY=loopback

# Body-size ceiling for a restored backup, which is one JSON document holding an
# entire board. Everything else on the server stays capped at 4mb.
# RESTORE_BODY_LIMIT=128mb

# Port the server listens on. Clients connect to http://localhost:PORT/mcp; the
# status dashboard is at http://localhost:PORT/
PORT=8787

# Interface to bind. Must stay 0.0.0.0 in Docker (compose publishes the port on
# 127.0.0.1 only). Set to 127.0.0.1 when running bare with `npm start`.
HOST=0.0.0.0

# Where the SQLite database lives. In Docker this is /data/orchestratinator.db
# (a named volume). For local `npm start` the default is ./data/orchestratinator.db
DB_PATH=./data/orchestratinator.db

# An MCP session with no traffic for this many minutes is closed. Clients
# re-initialize transparently (they get a 404, which the spec says to start over
# on), so this is cheap; it bounds memory and keeps the dashboard's "connected"
# from counting windows that are long gone. Default 15.
SESSION_TTL_MINUTES=15

# A claimed task with no completion after this many minutes auto-reopens (so an
# abandoned claim can't sit invisibly in `claimed`). Set comfortably above your
# longest expected task. Default 15.
CLAIM_TTL_MINUTES=15

# Default lifetime of a self-reported status when set_status doesn't pass its own
# ttl_seconds. Past it the dashboard stops believing the status and falls back to
# a derived state, so a crashed agent can't strand "waiting" on the board. Keep
# it short — a stale status the human trusts is worse than no status. Default 900.
STATUS_TTL_SECONDS=900
