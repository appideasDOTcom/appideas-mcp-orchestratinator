# Port the server listens on. Clients connect to http://localhost:PORT/mcp; the
# status dashboard is at http://localhost:PORT/
PORT=8787

# Interface to bind. Must stay 0.0.0.0 in Docker (compose publishes the port on
# 127.0.0.1 only). Set to 127.0.0.1 when running bare with `npm start`.
HOST=0.0.0.0

# Where the SQLite database lives. In Docker this is /data/orchestratinator.db
# (a named volume). For local `npm start` the default is ./data/orchestratinator.db
DB_PATH=./data/orchestratinator.db

# An MCP session with no traffic for this many minutes is closed. Clients
# re-initialize transparently (they get a 404, which the spec says to start over
# on), so this is cheap; it bounds memory and keeps the dashboard's "connected"
# from counting windows that are long gone. Default 15.
SESSION_TTL_MINUTES=15

# A claimed task with no completion after this many minutes auto-reopens (so an
# abandoned claim can't sit invisibly in `claimed`). Set comfortably above your
# longest expected task. Default 15.
CLAIM_TTL_MINUTES=15

# Default lifetime of a self-reported status when set_status doesn't pass its own
# ttl_seconds. Past it the dashboard stops believing the status and falls back to
# a derived state, so a crashed agent can't strand "waiting" on the board. Keep
# it short — a stale status the human trusts is worse than no status. Default 900.
STATUS_TTL_SECONDS=900
