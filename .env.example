# Port the HTTP MCP server listens on (clients connect to http://localhost:PORT/mcp)
PORT=8787

# Where the SQLite database lives. In Docker this is /data/orchestratinator.db
# (a named volume). For local `npm start` the default is ./data/orchestratinator.db
DB_PATH=./data/orchestratinator.db

# A claimed task with no completion after this many minutes auto-reopens (so an
# abandoned claim can't sit invisibly in `claimed`). Set comfortably above your
# longest expected task. Default 15.
CLAIM_TTL_MINUTES=15
