# Copy to .env (gitignored). `docker compose` reads .env for ${VAR} substitution
# and the server loads it itself, so `npm start` sees the same values.

# Shared secret every MCP client must present, as either
#   X-Orchestratinator-Key: <token>
# or
#   Authorization: Bearer <token>
# One key for all agents — it keeps a casual port-scan off the board, it does
# not make X-Agent trustworthy. Leave it empty to disable auth entirely.
#
# This guards /mcp and nothing else. The dashboard has no sign-in: it is open to
# anything that can reach the port, which is the intended model for a machine on
# a network you trust. Don't publish that port anywhere you don't.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ORCH_AUTH_TOKEN=

# off | warn | enforce. Defaults to enforce whenever a token is set; `off` is
# implied when it isn't. Use `warn` to roll auth out without interrupting agents
# that are mid-task: bad and missing keys are logged but allowed, so you can
# watch the log until every client has been updated, then switch to enforce.
ORCH_AUTH_MODE=enforce

# Which proxies to believe about the client's IP. Express syntax: `loopback` (the
# default), a subnet, a hop count, or `true` for "trust whatever X-Forwarded-For
# says". This only affects the address named in the auth warning when a client
# presents a bad key — useful when something is in front of this server, since
# otherwise every refusal appears to come from the proxy.
# TRUST_PROXY=loopback

# Body-size ceiling for a restored backup, which is one JSON document holding an
# entire board. Everything else on the server stays capped at 4mb.
# RESTORE_BODY_LIMIT=128mb

# Port the server listens on. Clients connect to http://localhost:PORT/mcp; the
# status dashboard is at http://localhost:PORT/
PORT=8787

# Interface to bind. Must stay 0.0.0.0 in Docker for the port mapping to work.
# Set to 127.0.0.1 when running bare with `npm start` and you want this machine
# only; leave it 0.0.0.0 to reach the board from other machines on your network.
HOST=0.0.0.0

# Where the SQLite database lives. In Docker this is /data/orchestratinator.db
# (a named volume). For local `npm start` the default is ./data/orchestratinator.db
DB_PATH=./data/orchestratinator.db

# An MCP session with no traffic for this many minutes is closed. Clients
# re-initialize transparently (they get a 404, which the spec says to start over
# on), so this is cheap; it bounds memory and keeps the dashboard's "connected"
# from counting windows that are long gone. Default 15.
SESSION_TTL_MINUTES=15

# A claimed task with no completion after this many minutes auto-reopens (so an
# abandoned claim can't sit invisibly in `claimed`). Set comfortably above your
# longest expected task. Default 15.
CLAIM_TTL_MINUTES=15

# Default lifetime of a self-reported status when set_status doesn't pass its own
# ttl_seconds. Past it the dashboard stops believing the status and falls back to
# a derived state, so a crashed agent can't strand "waiting" on the board. Keep
# it short — a stale status the human trusts is worse than no status. Default 900.
STATUS_TTL_SECONDS=900
